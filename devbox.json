{
  "$schema": "https://raw.githubusercontent.com/jetpack-io/devbox/main/.schema/devbox.schema.json",
  "packages": {
    "python":     "3.12",
    "poetry":     "latest",
    "clang":      "18.1.8",
    "conan":      "2.21.0",
    "protobuf":   "33.5",
    "cmake":      "4.1.2",
    "github-cli": "2.23.0",
    "go-task":    "3.45.5"
  },
  "env": {
    "POETRY_VIRTUALENVS_CREATE": "false",
    "RESOURCES_DIR":             "$DEVBOX_PROJECT_ROOT/resources",
    "RELEASE_DIR":               "$DEVBOX_PROJECT_ROOT/release",
    "BUILD_DIR":                 "$DEVBOX_PROJECT_ROOT/build",
    "CLANG_VERSION":             "18.1.8",
    "PROTO_VERSION":             "33.5",
    "CONAN_PROTOBUF_VERSION":    "6.33.5"
  }
}

{
  "$schema": "https://raw.githubusercontent.com/jetpack-io/devbox/main/.schema/devbox.schema.json",
  "packages": {
    "python":   "3.12",
    "poetry":   "latest",
    "go-task":  "latest",
    "protobuf": "3.21.12",
    "clang": "18.1.8"
  },
  "env": {
    "VENV_DIR":                      "$DEVBOX_PROJECT_ROOT/.venv",
    "POETRY_VIRTUALENVS_PATH":       "$DEVBOX_PROJECT_ROOT/.venv",
    "POETRY_VIRTUALENVS_IN_PROJECT": "true",
    "POETRY_VIRTUALENVS_CREATE":     "false",
    "CLANG_VERSION": "18.1.8",
    "PROTO_VERSION": "3.21.12"
  },
  "shell": {
    "init_hook": [
      "poetry install",
      ". $VENV_DIR/bin/activate"
    ]
  }
}
